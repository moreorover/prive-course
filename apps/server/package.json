{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "admin:bootstrap:local": "node scripts/bootstrap-admin-local.mjs",
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:execute:local": "wrangler d1 execute DB --local --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "dev": "wrangler dev src/index.ts --config wrangler.jsonc --port 3000 --env-file .env"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@prive-course/api": "workspace:*",
    "@prive-course/auth": "workspace:*",
    "@prive-course/env": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@prive-course/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "wrangler": "^4.107.0"
  }
}

{
  "name": "prive-course",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter web --filter server dev",
    "dev:infra": "ALCHEMY_TELEMETRY_DISABLED=1 vp run --filter @prive-course/infra dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "knip": "knip --no-config-hints",
    "lint": "vp lint",
    "format": "vp fmt",
    "react-doctor": "react-doctor --no-telemetry -y",
    "react-doctor:staged": "react-doctor --staged --no-telemetry -y",
    "staged": "vp staged",
    "test": "vp run -r test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:production": "node scripts/smoke.mjs --production",
    "smoke:checklist": "node -e \"console.log('Open SMOKE_TEST.md and run the manual checklist after vp run smoke passes')\"",
    "hooks:setup": "vp config",
    "admin:bootstrap:local": "vp run --filter server admin:bootstrap:local",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter server dev",
    "db:execute:local": "vp run --filter server db:execute:local",
    "db:migrate:local": "vp run --filter server db:migrate:local",
    "db:generate": "vp run --filter @prive-course/db db:generate",
    "deploy": "vp run --filter @prive-course/infra deploy",
    "destroy": "vp run --filter @prive-course/infra destroy"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@prive-course/config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "^6.26.0",
    "react-doctor": "^0.7.4",
    "typescript": "catalog:",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "packageManager": "pnpm@11.11.0"
}
